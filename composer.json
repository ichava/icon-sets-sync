{
    "name": "ichava/icon-sets-sync",
    "description": "Keeps the Ichava icon packs in step with their upstream registries. This package installs the signed release binary for your platform.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ichava", "icons", "svg", "icon-sets", "sync", "cli"],
    "homepage": "https://opensource.simtabi.com/products/ichava/icon-sets-sync",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/ichava/icon-sets-sync/issues",
        "source": "https://github.com/ichava/icon-sets-sync",
        "security": "https://github.com/ichava/icon-sets-sync/security/policy",
        "docs": "https://opensource.simtabi.com/documentation/ichava/icon-sets-sync/"
    },
    "require": {
        "php": "^8.4",
        "ext-openssl": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.6 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\IconSetsSync\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\IconSetsSync\\Tests\\": "php/tests/"
        }
    },
    "bin": [
        "bin/icon-sets-sync"
    ],
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
