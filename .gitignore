# Build output: make build / build-local / cross write here.
build/
dist/

# Tool caches (script-local downloads)
.cache/
.downloads/

# Go test coverage
coverage.out

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Composer (the PHP launcher). A library: the lock is never committed.
/vendor/
composer.lock

# Bytecode left on disk by the implementation removed before 0.1.0. Nothing
# here is Python any more; this keeps an old checkout's stale caches out of a
# commit. TestNoDockerOrPythonSurface fails if a .py file is tracked.
__pycache__/
*.py[cod]
