{
  "_note": "@phosphor-icons/core's assets/ (six weight folders). Upstream suffixes every weight but regular (`bold/house-bold.svg`); the pack keeps `bold/house.svg` (split-variants). Reproduces the committed pack byte for byte: a dry run at the pinned version against the local checkout on 2026-11-04 wrote 9,072 SVGs with 0 added, removed or changed.",
  "name": "icon-sets-phosphor",
  "pack": "ichava/icon-sets-phosphor",
  "pack_root": "/work/icon-sets-phosphor",
  "current_version": "2.1.1",
  "version_check_url": "https://registry.npmjs.org/@phosphor-icons/core/latest",
  "licence": "MIT",
  "licence_sha256": "ddbe6082ec3cf979db47e5af549d2849c5d6182b3e005ef91ce1dbb9eb122f11",
  "source": {
    "type": "npm",
    "package": "@phosphor-icons/core",
    "source_path": "assets"
  },
  "transforms": [
    {
      "type": "sanitise"
    },
    {
      "type": "split-variants",
      "variants": [
        {
          "path": "regular",
          "from": "regular"
        },
        {
          "path": "thin",
          "from": "thin",
          "suffix": "-thin"
        },
        {
          "path": "light",
          "from": "light",
          "suffix": "-light"
        },
        {
          "path": "bold",
          "from": "bold",
          "suffix": "-bold"
        },
        {
          "path": "fill",
          "from": "fill",
          "suffix": "-fill"
        },
        {
          "path": "duotone",
          "from": "duotone",
          "suffix": "-duotone"
        }
      ]
    }
  ],
  "sinks": [
    {
      "type": "filesystem",
      "root": "{pack_root}/resources/assets/svg/files"
    },
    {
      "type": "git-branch",
      "repo_root": "{pack_root}",
      "branch": "chore/sync-upstream-{version}"
    }
  ]
}
