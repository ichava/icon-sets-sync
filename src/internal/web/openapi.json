  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "an iss_ token from `icon-sets-sync api token create`"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          }
        }
      },
      "SyncRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "type": "boolean",
            "default": true,
            "description": "false makes a real run: it writes, commits, pushes and opens a pull request"
          },
          "force": {
            "type": "boolean",
            "default": false
          },
          "concurrency": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "POST /api/v1/sync only: the packs to sync; empty is every pack"
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sync",
              "sync-all",
              "recipe",
              "audit"
            ]
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dry_run": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "started": {
            "type": "string",
            "format": "date-time"
          },
          "ended": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "needs-review"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Pack": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "pack": {
            "type": "string"
          },
          "recipe": {
            "type": "string"
          },
          "current_version": {
            "type": "string"
          },
          "upstream": {
            "type": "object"
          },
          "stats": {
            "type": "object"
          },
          "running_job": {
            "type": "string"
          },
          "notes": {
            "type": "object"
          }
        }
      }
    }
  }
}
