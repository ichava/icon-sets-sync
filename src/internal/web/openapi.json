{
  "openapi": "3.1.0",
  "info": {
    "title": "icon-sets-sync REST API",
    "version": "1",
    "description": "The REST API `icon-sets-sync serve` answers under /api/v1 when api.enabled is on. Every request carries Authorization: Bearer <token>; `icon-sets-sync api token create` makes one. x-scope names the scope each operation needs (admin carries every scope). Under --read-only the operations that run a sync or change a file are not served. Errors are RFC 9457 problem documents. See docs/tools/api.md.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
