{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job.progress",
  "description": "A pipeline stage of a run started, finished or failed. Sent on the event stream only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "stage",
    "state"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$",
      "description": "the run's id, as /jobs/{id} and /api/v1/jobs/{id} take it"
    },
    "pipeline": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "started",
        "finished",
        "failed"
      ]
    },
    "error": {
      "type": "string"
    }
  }
}
