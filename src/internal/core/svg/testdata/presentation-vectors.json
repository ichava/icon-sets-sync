      ]
    },
    {
      "label": "a script inside a marker is stripped",
      "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"><marker id=\"m\"><script>alert(1)</script><path d=\"M0 0\"/></marker></svg>",
      "clean": false,
      "expect": [
        {
          "element": "marker",
          "present": true
        },
        {
          "element": "script",
          "present": false
        }
      ]
    },
    {
      "label": "event handlers on a marker and inside it are stripped",
      "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\"><marker id=\"m\" onload=\"alert(1)\"><path onclick=\"alert(1)\" d=\"M0 0\"/></marker></svg>",
      "clean": false,
