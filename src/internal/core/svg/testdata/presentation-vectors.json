  "documents": [
    {
      "label": "the US flag canton: a marker drawn by marker-mid survives intact",
      "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 640 480\"><path fill=\"#192f5d\" d=\"M0 0h364.8v258.5H0\"/><marker id=\"us-a\" markerHeight=\"30\" markerWidth=\"30\"><path fill=\"#fff\" d=\"m14 0 9 27L0 10h28L5 27z\"/></marker><path fill=\"none\" marker-mid=\"url(#us-a)\" d=\"m0 0 16 11h61 61 61 61 60\"/></svg>",
      "clean": true,
      "expect": [
        {
          "element": "marker",
          "present": true
        },
        {
          "element": "marker",
          "attribute": "id",
          "present": true
        },
        {
          "element": "marker",
          "attribute": "markerHeight",
          "present": true
